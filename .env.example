# Service ports
GATEWAY_PORT=8080
ORCHESTRATOR_PORT=8081
RELIABILITY_PORT=8082
GUARDRAILS_PORT=8083
MEMORY_PORT=8084
REPLAY_PORT=8085
CHAOS_PORT=8086

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aegisflow
POSTGRES_USER=aegis
POSTGRES_PASSWORD=devonly_change_me

# Redis
REDIS_URL=redis://redis:6379/0

# NATS
NATS_URL=nats://nats:4222
NATS_STREAM=AEGIS

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=aegisflow
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# Auth
JWT_SECRET=devonly_change_me
JWT_ISSUER=aegisflow.local
JWT_AUDIENCE=aegisflow.api

# Rate limit defaults
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Reliability defaults
RELIABILITY_MIN_CONFIDENCE=0.70
RELIABILITY_GROUNDING_TAU=0.78
CIRCUIT_BREAKER_THRESHOLD=0.5
CIRCUIT_BREAKER_WINDOW_SEC=30
CIRCUIT_BREAKER_COOLDOWN_SEC=15

# LLM providers (placeholders - real keys in your secret store)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_VLLM_URL=

# Chaos
CHAOS_ENABLED=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
